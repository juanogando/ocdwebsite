---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ArchiveGrid from '../../../components/ArchiveGrid.astro';
import { SITE_TITLE } from '../../../consts';
import { type ArchiveCollection, getArchive } from '../../../lib/archive';

export async function getStaticPaths() {
	const { collections } = await getArchive();
	return collections.map((collection) => ({ params: { collection: collection.id }, props: { collection } }));
}

interface Props {
	collection: ArchiveCollection;
}

const { collection } = Astro.props;
const { entries, brands } = await getArchive();
const brand = brands.find((b) => b.id === collection.data.brand.id)!;
const items = entries.filter((e) => e.collection?.id === collection.id);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${collection.data.name} | ${brand.data.name} | ${SITE_TITLE}`}
			description={collection.data.description ?? collection.data.name}
			image={collection.data.cover}
		/>
		<style>
			main {
				width: 1100px;
			}
			.sub {
				color: rgb(var(--gray));
				font-size: 0.8em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="sub">
				<a href="/archive/">Archive</a> / <a href={`/archive/brands/${brand.id}/`}>{brand.data.name}</a>
			</p>
			<h1>{collection.data.name}</h1>
			<p class="sub">{[collection.data.season, collection.data.year].filter(Boolean).join(' ')} · {items.length} items</p>
			{collection.data.description && <p>{collection.data.description}</p>}
			<ArchiveGrid entries={items} />
		</main>
		<Footer />
	</body>
</html>
