---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Video from '../../components/Video.astro';
import VideoGrid from '../../components/VideoGrid.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';

const videos = (await getCollection('video')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Videos | ${SITE_TITLE}`} description="Watch the latest clips." />
		<style>
			main {
				width: 960px;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				font-size: 1.25rem;
				line-height: 1.2;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			li a {
				display: block;
				margin-top: 0.75rem;
				text-decoration: none;
			}
			li a:hover .title,
			li a:hover .date {
				color: var(--accent);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Videos</h1>
			<section>
				<VideoGrid as="ul">
					{
						videos.map((video) => (
							<li>
								<Video
									src={video.data.src}
									poster={video.data.poster}
									captions={video.data.captions}
									aspect={video.data.aspect}
									label={video.data.title}
								/>
								<a href={`/videos/${video.id}/`}>
									<h2 class="title">{video.data.title}</h2>
									<p class="date">
										<FormattedDate date={video.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</VideoGrid>
			</section>
		</main>
		<Footer />
	</body>
</html>
